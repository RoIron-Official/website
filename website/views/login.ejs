<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Crect width='128' height='128' rx='28' fill='%230a0a0a'/%3E%3Crect x='4' y='4' width='120' height='120' rx='24' stroke='%234a9eff' stroke-width='2.5'/%3E%3Ctext x='64' y='82' font-size='52' font-weight='700' fill='%234a9eff' text-anchor='middle' font-family='Helvetica Neue, sans-serif'%3ERI%3C/text%3E%3C/svg%3E" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="container" style="max-width:480px;">
      <div class="section-header">
        <h2>Sign In</h2>
        <p>Enter your RoIron secret key to access your dashboard</p>
      </div>
      <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:32px;">
        <form id="login-form" style="display:flex;flex-direction:column;gap:16px;">
          <div>
            <label style="display:block;font-size:13px;color:#888888;margin-bottom:6px;">Secret Key</label>
            <div style="position:relative;">
              <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#444444;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V11"/></svg>
              </span>
              <input type="password" id="secret-key" placeholder="ROIRON-SECRET-XXXX-XXXX-XXXX-XXXX" style="width:100%;padding:14px 14px 14px 44px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:8px;color:#ffffff;font-size:14px;font-family:monospace;outline:none;transition:border-color 0.3s ease;" />
            </div>
          </div>

          <button type="submit" style="width:100%;padding:14px;background:#4a9eff;border:none;border-radius:8px;color:#ffffff;font-size:16px;font-weight:600;cursor:pointer;transition:all 0.3s ease;display:flex;align-items:center;justify-content:center;gap:8px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            Sign In
          </button>
        </form>

        <div id="login-error" style="margin-top:16px;font-size:14px;color:#ff6b6b;display:none;padding:12px 16px;background:rgba(255,50,50,0.06);border:1px solid rgba(255,50,50,0.12);border-radius:6px;"></div>

        <div style="margin-top:20px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.06);font-size:13px;color:#666666;text-align:center;">
          Don't have a key? <a href="/license" style="color:#4a9eff;text-decoration:none;font-weight:500;">Get license</a>
        </div>

        <div style="margin-top:12px;padding:12px 16px;background:rgba(74,158,255,0.04);border:1px solid rgba(74,158,255,0.08);border-radius:6px;font-size:12px;color:#666666;text-align:center;display:flex;align-items:center;justify-content:center;gap:6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          <span>Your session is saved for 30 days</span>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    (function() {
      const form = document.getElementById('login-form');
      const input = document.getElementById('secret-key');
      const errorEl = document.getElementById('login-error');

      // Check if already logged in
      fetch('/api/auth/session')
        .then(res => res.json())
        .then(data => {
          if (data.authenticated) {
            window.location.href = '/dashboard';
          }
        })
        .catch(() => {});

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const key = input.value.trim();
        
        if (!key) {
          errorEl.textContent = 'Please enter your secret key';
          errorEl.style.display = 'block';
          return;
        }

        errorEl.style.display = 'none';

        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = `
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="animation:spin 1s linear infinite;">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
          Verifying...
        `;

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ secretKey: key })
          });
          const data = await res.json();

          if (data.success) {
            window.location.href = '/dashboard';
          } else {
            errorEl.textContent = data.error || 'Invalid secret key. Please check and try again.';
            errorEl.style.display = 'block';
            btn.disabled = false;
            btn.innerHTML = `
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
              Sign In
            `;
          }
        } catch (err) {
          errorEl.textContent = 'Network error. Please try again.';
          errorEl.style.display = 'block';
          btn.disabled = false;
          btn.innerHTML = `
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            Sign In
          `;
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          form.dispatchEvent(new Event('submit'));
        }
      });

      input.addEventListener('focus', () => {
        input.style.borderColor = '#4a9eff';
        input.style.boxShadow = '0 0 0 3px rgba(74,158,255,0.1)';
      });

      input.addEventListener('blur', () => {
        input.style.borderColor = 'rgba(255,255,255,0.08)';
        input.style.boxShadow = 'none';
      });

      // Add spin animation
      const style = document.createElement('style');
      style.textContent = `
        @keyframes spin {
          from { transform: rotate(0deg); }
          to { transform: rotate(360deg); }
        }
      `;
      document.head.appendChild(style);

    })();
  </script>
</body>
</html>
