<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Crect width='128' height='128' rx='28' fill='%230a0a0a'/%3E%3Crect x='4' y='4' width='120' height='120' rx='24' stroke='%234a9eff' stroke-width='2.5'/%3E%3Ctext x='64' y='82' font-size='52' font-weight='700' fill='%234a9eff' text-anchor='middle' font-family='Helvetica Neue, sans-serif'%3ERI%3C/text%3E%3C/svg%3E" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="container" style="text-align:center;max-width:600px;">
      <div class="section-header">
        <h2>Download RoIron</h2>
        <p>Get the latest version of RoIron for your browser</p>
      </div>
      <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:40px;">
        <div style="margin-bottom:16px;">
          <svg width="64" height="64" viewBox="0 0 128 128" fill="none">
            <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
            <rect x="4" y="4" width="120" height="120" rx="24" stroke="#4a9eff" stroke-width="2.5"/>
            <text x="64" y="82" font-size="52" font-weight="700" fill="#4a9eff" text-anchor="middle" font-family="Helvetica Neue, sans-serif">RI</text>
          </svg>
        </div>
        <h3 style="font-size:24px;margin-bottom:8px;">RoIron v<%= version %></h3>
        <p style="color:#888888;margin-bottom:24px;">Chrome / Edge / Brave compatible</p>
        <a href="/download/roiron.crx" class="btn btn-primary" style="font-size:18px;padding:14px 40px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download .crx
        </a>
        <div style="margin-top:24px;font-size:13px;color:#666666;text-align:left;padding:16px;background:rgba(255,255,255,0.02);border-radius:6px;border:1px solid rgba(255,255,255,0.04);">
          <p style="display:flex;align-items:center;gap:8px;margin:4px 0;">
            <span style="color:#4a9eff;">1.</span> Download the .crx file
          </p>
          <p style="display:flex;align-items:center;gap:8px;margin:4px 0;">
            <span style="color:#4a9eff;">2.</span> Open <kbd>chrome://extensions</kbd>
          </p>
          <p style="display:flex;align-items:center;gap:8px;margin:4px 0;">
            <span style="color:#4a9eff;">3.</span> Enable <kbd>Developer mode</kbd>
          </p>
          <p style="display:flex;align-items:center;gap:8px;margin:4px 0;">
            <span style="color:#4a9eff;">4.</span> Drag the .crx file into the page
          </p>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
