<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Crect width='128' height='128' rx='28' fill='%230a0a0a'/%3E%3Crect x='4' y='4' width='120' height='120' rx='24' stroke='%234a9eff' stroke-width='2.5'/%3E%3Ctext x='64' y='82' font-size='52' font-weight='700' fill='%234a9eff' text-anchor='middle' font-family='Helvetica Neue, sans-serif'%3ERI%3C/text%3E%3C/svg%3E" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="container" style="max-width:800px;">
      <div class="section-header">
        <h2>Documentation</h2>
        <p>Getting started with RoIron</p>
      </div>
      <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:30px;margin-top:20px;">
        <h3 style="margin-bottom:12px;display:flex;align-items:center;gap:8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Installation
        </h3>
        <p style="color:#888888;margin-bottom:16px;">Download the <code>.crx</code> file from the <a href="/download" style="color:#4a9eff;">download page</a>.</p>
        <ol style="color:#888888;padding-left:20px;line-height:2.2;">
          <li>Open <kbd>chrome://extensions</kbd> in your browser</li>
          <li>Enable <kbd>Developer mode</kbd> (top right)</li>
          <li>Drag the <code>.crx</code> file into the page</li>
          <li>Click <kbd>Add extension</kbd></li>
        </ol>

        <h3 style="margin-top:24px;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V11"/></svg>
          License Activation
        </h3>
        <p style="color:#888888;margin-bottom:16px;">After installation, go to <kbd>https://www.roblox.com/roiron</kbd> and enter your license key.</p>
        <p style="color:#888888;">You'll receive a <code>secretKey</code> after activation — keep it safe!</p>

        <h3 style="margin-top:24px;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="2" stroke-linecap="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Website Login
        </h3>
        <p style="color:#888888;">Use your <code>secretKey</code> to <a href="/login" style="color:#4a9eff;">sign in</a> to the website and view your dashboard.</p>

        <h3 style="margin-top:24px;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          Keyboard Shortcuts
        </h3>
        <ul style="color:#888888;padding-left:20px;line-height:2.2;">
          <li><kbd>Alt + R</kbd> — Open RoIron Home</li>
          <li><kbd>Alt + S</kbd> — Open RoIron Settings</li>
        </ul>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
