<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Crect width='128' height='128' rx='28' fill='%230a0a0a'/%3E%3Crect x='4' y='4' width='120' height='120' rx='24' stroke='%234a9eff' stroke-width='2.5'/%3E%3Ctext x='64' y='82' font-size='52' font-weight='700' fill='%234a9eff' text-anchor='middle' font-family='Helvetica Neue, sans-serif'%3ERI%3C/text%3E%3C/svg%3E" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>All Features</h2>
        <p>Everything RoIron has to offer</p>
      </div>
      <div class="features-grid" style="grid-template-columns:1fr 1fr;">
        <div class="feature-card"><h3>Ad Blocker</h3><p>Blocks ads, analytics, and tracking scripts for a clean experience.</p></div>
        <div class="feature-card"><h3>Dark Theme</h3><p>Fully customizable dark theme for all Roblox pages.</p></div>
        <div class="feature-card"><h3>XP &amp; Leveling</h3><p>Earn XP for playing, track your level, and compete on leaderboards.</p></div>
        <div class="feature-card"><h3>Friend Status</h3><p>See online status of your friends directly on their avatars.</p></div>
        <div class="feature-card"><h3>Avatar Customizer</h3><p>Glow, Fire, Rainbow, Galaxy, Diamond effects for your avatar.</p></div>
        <div class="feature-card"><h3>Server Region</h3><p>See server region and join random servers with one click.</p></div>
        <div class="feature-card"><h3>Image Optimizer</h3><p>Lazy loading for images, faster page loads.</p></div>
        <div class="feature-card"><h3>Keyboard Shortcuts</h3><p>Alt+R for home, Alt+S for settings.</p></div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
