<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/icons.css" />
</head>
<body>
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <span class="icon icon-lg icon-white">
          <svg viewBox="0 0 128 128" fill="none">
            <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
            <rect x="4" y="4" width="120" height="120" rx="24" stroke="currentColor" stroke-width="2.5"/>
            <text x="64" y="82" font-size="52" font-weight="700" fill="currentColor" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif">RI</text>
          </svg>
        </span>
        RoIron
      </a>
      <nav class="nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/features" class="nav-link">Features</a>
        <a href="/download" class="nav-link">Download</a>
        <a href="/login" class="nav-link">Login</a>
      </nav>
    </div>
  </header>

  <main style="padding:60px 20px;">
    <div class="container" style="max-width:800px;">
      <h1 style="font-size:32px;font-weight:700;color:#ffffff;margin:0 0 8px;">Documentation</h1>
      <p style="font-size:16px;color:#888888;margin:0 0 32px;">Everything you need to know about RoIron</p>

      <div style="display:flex;flex-direction:column;gap:16px;">
        <div style="background:#141414;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:20px;">
          <h3 style="font-size:16px;font-weight:600;color:#ffffff;margin:0 0 8px;">Getting Started</h3>
          <p style="font-size:14px;color:#888888;margin:0;">Install the extension, activate your license, and start using all features immediately.</p>
        </div>

        <div style="background:#141414;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:20px;">
          <h3 style="font-size:16px;font-weight:600;color:#ffffff;margin:0 0 8px;">License Activation</h3>
          <p style="font-size:14px;color:#888888;margin:0;">Enter your license key on the RoIron page. The extension will handle the rest.</p>
        </div>

        <div style="background:#141414;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:20px;">
          <h3 style="font-size:16px;font-weight:600;color:#ffffff;margin:0 0 8px;">XP & Leveling</h3>
          <p style="font-size:14px;color:#888888;margin:0;">Earn XP by playing Roblox or using Studio. Level up to unlock avatar decorations.</p>
        </div>

        <div style="background:#141414;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:20px;">
          <h3 style="font-size:16px;font-weight:600;color:#ffffff;margin:0 0 8px;">Privacy</h3>
          <p style="font-size:14px;color:#888888;margin:0;">RoIron blocks trackers and analytics. Your data is never sent to third parties.</p>
        </div>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-bottom">
        &copy; <%= year %> RoIron. All rights reserved.
      </div>
    </div>
  </footer>
</body>
</html>
