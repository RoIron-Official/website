<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="section">
            <div class="container">
                <div class="section-header">
                    <h2>Documentation</h2>
                    <p>Everything you need to know about RoIron</p>
                </div>

                <div style="max-width: 800px; margin: 0 auto;">
                    <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px; margin-bottom: 16px;">
                        <h3 style="color: #ffffff; font-size: 18px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                            <%- include('partials/icons', { icon: 'rocket', class: 'icon-md' }) %>
                            Getting Started
                        </h3>
                        <p style="color: #888888; font-size: 14px; line-height: 1.8;">
                            RoIron is a lightweight Roblox enhancement tool. After installing the extension,
                            navigate to <code>https://www.roblox.com/roiron</code>
                            to activate your license and start using all features.
                        </p>
                    </div>

                    <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px; margin-bottom: 16px;">
                        <h3 style="color: #ffffff; font-size: 18px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                            <%- include('partials/icons', { icon: 'shield', class: 'icon-md' }) %>
                            License Activation
                        </h3>
                        <p style="color: #888888; font-size: 14px; line-height: 1.8;">
                            To activate RoIron, you need a valid license key. Visit
                            <code>https://www.roblox.com/roiron</code>
                            and enter your license key. You will be redirected to the home page upon successful activation.
                        </p>
                    </div>

                    <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px; margin-bottom: 16px;">
                        <h3 style="color: #ffffff; font-size: 18px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                            <%- include('partials/icons', { icon: 'palette', class: 'icon-md' }) %>
                            Theme Creator
                        </h3>
                        <p style="color: #888888; font-size: 14px; line-height: 1.8;">
                            RoIron includes a powerful Theme Creator. Click the paint palette icon in the sidebar
                            to open the editor. You can pick any element on the page and customize its styles:
                            colors, sizes, spacing, borders, and more. Changes are applied globally.
                        </p>
                    </div>

                    <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px;">
                        <h3 style="color: #ffffff; font-size: 18px; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                            <%- include('partials/icons', { icon: 'github', class: 'icon-md' }) %>
                            Development
                        </h3>
                        <p style="color: #888888; font-size: 14px; line-height: 1.8;">
                            RoIron is open-source. You can find the source code and contribute on GitHub.
                            <br><br>
                            <code style="background: rgba(255,255,255,0.04); padding: 4px 12px; border-radius: 4px; color: #4a9eff; display: inline-block;">
                                git clone https://github.com/RoIron-Official/roiron.git
                            </code>
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
