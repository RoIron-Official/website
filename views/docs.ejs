<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="logo">
          <svg width="32" height="32" viewBox="0 0 128 128" fill="none">
            <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
            <rect x="4" y="4" width="120" height="120" rx="24" stroke="#ffffff" stroke-width="2.5"/>
            <text x="64" y="82" font-size="52" font-weight="700" fill="#ffffff" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif">RI</text>
          </svg>
          <span class="logo-text">RoIron</span>
        </a>
        <nav class="nav">
          <a href="/" class="nav-link">Home</a>
          <a href="/features" class="nav-link">Features</a>
          <a href="/download" class="nav-link">Download</a>
          <a href="/docs" class="nav-link">Docs</a>
          <a href="/license" class="nav-link">License</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h1>Documentation</h1>
          <p>Everything you need to know</p>
        </div>
        <div style="max-width:800px;margin:0 auto;">
          <div style="margin-bottom:24px;padding:20px;background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:12px;">
            <h2 style="font-size:20px;margin-bottom:12px;">Getting Started</h2>
            <ol style="padding-left:20px;color:#888888;font-size:14px;">
              <li><strong>Install</strong> — Download RoIron from the <a href="/download" style="color:#4a9eff;">download page</a></li>
              <li><strong>Activate</strong> — Open Roblox and click the RoIron icon</li>
              <li><strong>Explore</strong> — Use the RoIron menu to access all features</li>
            </ol>
          </div>
          <div style="margin-bottom:24px;padding:20px;background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:12px;">
            <h2 style="font-size:20px;margin-bottom:12px;">Keyboard Shortcuts</h2>
            <table style="width:100%;border-collapse:collapse;">
              <tr><th style="padding:8px 12px;text-align:left;border-bottom:1px solid rgba(255,255,255,0.06);color:#888888;">Shortcut</th><th style="padding:8px 12px;text-align:left;border-bottom:1px solid rgba(255,255,255,0.06);color:#888888;">Action</th></tr>
              <tr><td style="padding:8px 12px;border-bottom:1px solid rgba(255,255,255,0.06);"><kbd style="background:rgba(255,255,255,0.04);padding:2px 10px;border-radius:4px;">Alt + R</kbd></td><td style="padding:8px 12px;border-bottom:1px solid rgba(255,255,255,0.06);">Open RoIron Home</td></tr>
              <tr><td style="padding:8px 12px;"><kbd style="background:rgba(255,255,255,0.04);padding:2px 10px;border-radius:4px;">Alt + S</kbd></td><td style="padding:8px 12px;">Open Settings</td></tr>
            </table>
          </div>
          <div style="padding:20px;background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:12px;">
            <h2 style="font-size:20px;margin-bottom:12px;">Support</h2>
            <p style="color:#888888;font-size:14px;">Join <a href="https://discord.gg/9DD3vD6jkr" target="_blank" style="color:#4a9eff;">Discord</a> for support</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="footer-logo">
            <svg width="28" height="28" viewBox="0 0 128 128" fill="none">
              <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
              <rect x="4" y="4" width="120" height="120" rx="24" stroke="#ffffff" stroke-width="2.5"/>
              <text x="64" y="82" font-size="52" font-weight="700" fill="#ffffff" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif">RI</text>
            </svg>
            <span>RoIron</span>
          </div>
          <p class="footer-desc">Lightweight Roblox enhancement tool.</p>
          <p class="footer-version">Version <%= version %></p>
        </div>
        <div>
          <h4>Product</h4>
          <a href="/features">Features</a>
          <a href="/download">Download</a>
          <a href="/docs">Documentation</a>
        </div>
        <div>
          <h4>Legal</h4>
          <a href="/license">License</a>
        </div>
        <div>
          <h4>Community</h4>
          <a href="https://discord.gg/9DD3vD6jkr" target="_blank">Discord</a>
          <a href="https://github.com/RoIron-Official/extension" target="_blank">GitHub</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; <%= year %> RoIron. All rights reserved.</span>
      </div>
    </div>
  </footer>
</body>
</html>
