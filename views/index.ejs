<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            v<%= version %> · Lightweight & Fast
          </div>
          <h1>
            <span>RoIron</span> — Roblox<br />Optimizer & Enhancer
          </h1>
          <p>
            Performance-focused extension with built-in ad blocker,
            dark theme, XP tracking, and a clean, modern interface.
          </p>
          <div class="hero-actions">
            <a href="/download" class="btn btn-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              Download Extension
            </a>
            <a href="/features" class="btn btn-outline">Features</a>
          </div>
        </div>
        <div class="hero-card">
          <div class="hero-card-header">
            <div class="hero-card-dots"><span></span><span></span><span></span></div>
            <span>roiron — stats</span>
          </div>
          <div class="hero-card-body">
            <div class="hero-card-stats">
              <div><span class="stat-value" id="stat-users">0</span><span class="stat-label">Users</span></div>
              <div><span class="stat-value" id="stat-licenses">0</span><span class="stat-label">Licenses</span></div>
              <div><span class="stat-value" id="stat-xp">0</span><span class="stat-label">Total XP</span></div>
            </div>
            <div class="hero-card-features">
              <span>🚀 Ad-Free</span>
              <span>🌙 Dark Theme</span>
              <span>⚡ Lightweight</span>
              <span>🏆 Leaderboards</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Why RoIron?</h2>
        <p>Everything you need to enhance your Roblox experience</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <span class="icon icon-lg icon-primary">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            </span>
          </div>
          <h3>XP & Leveling</h3>
          <p>Earn XP for playing, track your level, and compete on leaderboards.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <span class="icon icon-lg icon-primary">
              <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M2 8h20M2 16h20"/></svg>
            </span>
          </div>
          <h3>Dark Theme</h3>
          <p>Fully customizable dark theme for all Roblox pages. Easy on the eyes.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <span class="icon icon-lg icon-primary">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M4 4l16 16M20 4L4 20"/></svg>
            </span>
          </div>
          <h3>Ad Blocker</h3>
          <p>Built-in ad blocking for scripts, images, and analytics. Cleaner browsing.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <span class="icon icon-lg icon-primary">
              <svg viewBox="0 0 24 24"><polygon points="12 2 15 8 22 8 16 12 18 18 12 14 6 18 8 12 2 8 9 8"/></svg>
            </span>
          </div>
          <h3>Friend Status</h3>
          <p>See online status of your friends directly on their avatars.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <span class="icon icon-lg icon-primary">
              <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="2"/><path d="M2 12h20"/><circle cx="12" cy="12" r="3"/></svg>
            </span>
          </div>
          <h3>Avatar Customizer</h3>
          <p>Glow, Fire, Rainbow, Galaxy, Diamond — customize your avatar with effects.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">
            <span class="icon icon-lg icon-primary">
              <svg viewBox="0 0 24 24"><polygon points="2 20 12 4 22 20"/><path d="M8 20h8"/><path d="M12 4v16"/></svg>
            </span>
          </div>
          <h3>Server Region</h3>
          <p>See server region and join random servers with one click.</p>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    async function fetchStats() {
      try {
        const res = await fetch('/api/db/stats');
        const data = await res.json();
        if (data.success) {
          document.getElementById('stat-users').textContent = data.users;
          document.getElementById('stat-licenses').textContent = data.licenses;
          document.getElementById('stat-xp').textContent = data.total_xp.toLocaleString();
        }
      } catch (e) {
        console.warn('Stats unavailable');
      }
    }
    fetchStats();
    setInterval(fetchStats, 30000);
  </script>
</body>
</html>
