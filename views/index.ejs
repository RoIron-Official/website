<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="hero">
            <div class="container">
                <div class="hero-content">
                    <div class="hero-text">
                        <div class="hero-badge">
                            <span class="badge-dot"></span>
                            <span>v<%= version %> · Available Now</span>
                        </div>
                        <h1>RoIron<br><span>Roblox Optimizer</span></h1>
                        <p>Lightweight Roblox enhancement tool with focus on performance and privacy.</p>
                        <div class="hero-actions">
                            <a href="/download" class="btn btn-primary">
                                <%- include('partials/icons', { icon: 'download', class: 'icon-sm' }) %>
                                Download Extension
                            </a>
                            <a href="/features" class="btn btn-outline">
                                <%- include('partials/icons', { icon: 'arrowRight', class: 'icon-sm' }) %>
                                Learn More
                            </a>
                        </div>
                    </div>
                    <div class="hero-card">
                        <div class="hero-card-header">
                            <span class="hero-card-dots">
                                <span></span><span></span><span></span>
                            </span>
                            <span>RoIron v<%= version %></span>
                        </div>
                        <div class="hero-card-body">
                            <div class="hero-card-stats">
                                <div>
                                    <span class="stat-value">50+</span>
                                    <span class="stat-label">Features</span>
                                </div>
                                <div>
                                    <span class="stat-value">100%</span>
                                    <span class="stat-label">Privacy</span>
                                </div>
                                <div>
                                    <span class="stat-value">1.3.9</span>
                                    <span class="stat-label">Version</span>
                                </div>
                            </div>
                            <div class="hero-card-features">
                                <span>#Performance</span>
                                <span>#Privacy</span>
                                <span>#Lightweight</span>
                                <span>#OpenSource</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="section-header">
                    <h2>Why RoIron?</h2>
                    <p>Everything you need to enhance your Roblox experience</p>
                </div>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'lightning', class: 'icon-xl' }) %>
                        </div>
                        <h3>Performance</h3>
                        <p>Lightweight and fast — no unnecessary bloat.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'lock', class: 'icon-xl' }) %>
                        </div>
                        <h3>Privacy First</h3>
                        <p>Your data stays yours. No tracking, no selling.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'palette', class: 'icon-xl' }) %>
                        </div>
                        <h3>Custom Themes</h3>
                        <p>Full theme customization with built-in editor.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'shield', class: 'icon-xl' }) %>
                        </div>
                        <h3>Ad Blocker</h3>
                        <p>Block annoying ads and tracking scripts.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'trophy', class: 'icon-xl' }) %>
                        </div>
                        <h3>Leaderboards</h3>
                        <p>Compete with friends and track your progress.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'rocket', class: 'icon-xl' }) %>
                        </div>
                        <h3>Quick Actions</h3>
                        <p>Join games faster with Play and Random buttons.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
