<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/icons.css" />
</head>
<body>
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <span class="icon icon-lg icon-white">
          <svg viewBox="0 0 128 128" fill="none">
            <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
            <rect x="4" y="4" width="120" height="120" rx="24" stroke="currentColor" stroke-width="2.5"/>
            <text x="64" y="82" font-size="52" font-weight="700" fill="currentColor" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif">RI</text>
          </svg>
        </span>
        RoIron
      </a>
      <nav class="nav">
        <a href="/features" class="nav-link">Features</a>
        <a href="/docs" class="nav-link">Docs</a>
        <a href="/download" class="nav-link">
          <span class="icon icon-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </span>
          Download
        </a>
        <a href="/login" class="nav-link">
          <span class="icon icon-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
              <polyline points="10 17 15 12 10 7"/>
              <line x1="15" y1="12" x2="3" y2="12"/>
            </svg>
          </span>
          Login
        </a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-text">
            <div class="hero-badge">
              <span class="badge-dot"></span>
              <span>v<%= version %> · Active</span>
            </div>
            <h1>
              Optimize Your<br />
              <span>Roblox Experience</span>
            </h1>
            <p>
              Lightweight extension with focus on performance, privacy,
              and advanced customization tools for Roblox.
            </p>
            <div class="hero-actions">
              <a href="/download" class="btn btn-primary">
                <span class="icon icon-sm">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                </span>
                Download Extension
              </a>
              <a href="/features" class="btn btn-outline">
                <span class="icon icon-sm">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                </span>
                View Features
              </a>
            </div>
          </div>
          <div class="hero-card">
            <div class="hero-card-header">
              <span class="icon icon-sm icon-muted">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2"/>
                  <line x1="8" y1="21" x2="16" y2="21"/>
                  <line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
              </span>
              <span>RoIron v<%= version %></span>
              <span class="hero-card-dots"><span></span><span></span><span></span></span>
            </div>
            <div class="hero-card-body">
              <div class="hero-card-stats">
                <div>
                  <span class="stat-value">500+</span>
                  <span class="stat-label">Users</span>
                </div>
                <div>
                  <span class="stat-value">25+</span>
                  <span class="stat-label">Features</span>
                </div>
                <div>
                  <span class="stat-value">99%</span>
                  <span class="stat-label">Uptime</span>
                </div>
              </div>
              <div class="hero-card-features">
                <span>Dark Theme</span>
                <span>XP System</span>
                <span>Game Optimizer</span>
                <span>Privacy First</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>Why RoIron?</h2>
          <p>Built for Roblox enthusiasts who care about performance</p>
        </div>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">
              <span class="icon icon-xl icon-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              </span>
            </div>
            <h3>Privacy First</h3>
            <p>Blocks trackers and analytics. Your data stays yours.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <span class="icon icon-xl icon-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <polyline points="12 6 12 12 16 14"/>
                </svg>
              </span>
            </div>
            <h3>Lightweight</h3>
            <p>Minimal resource usage. No bloat. Just performance.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">
              <span class="icon icon-xl icon-primary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                  <path d="M2 17l10 5 10-5"/>
                  <path d="M2 12l10 5 10-5"/>
                </svg>
              </span>
            </div>
            <h3>XP & Leveling</h3>
            <p>Earn XP while playing. Track your progress and level up.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <div class="footer-logo">
            <span class="icon icon-lg icon-white">
              <svg viewBox="0 0 128 128" fill="none">
                <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
                <rect x="4" y="4" width="120" height="120" rx="24" stroke="currentColor" stroke-width="2.5"/>
                <text x="64" y="82" font-size="52" font-weight="700" fill="currentColor" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif">RI</text>
              </svg>
            </span>
            RoIron
          </div>
          <p class="footer-desc">Roblox optimization tool for power users.</p>
          <p class="footer-version">v<%= version %></p>
        </div>
        <div>
          <h4>Product</h4>
          <a href="/features">Features</a>
          <a href="/docs">Documentation</a>
          <a href="/download">Download</a>
        </div>
        <div>
          <h4>Resources</h4>
          <a href="https://github.com/RoIron-Official/roiron" target="_blank">GitHub</a>
          <a href="/license">License</a>
          <a href="/stats">Stats</a>
        </div>
        <div>
          <h4>Community</h4>
          <a href="https://discord.gg/9DD3vD6jkr" target="_blank">
            <span class="icon icon-sm">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.369a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.01.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.01.076.076 0 0 0 .032-.054c.5-5.093-.838-9.62-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
              </svg>
            </span>
            Discord
          </a>
        </div>
      </div>
      <div class="footer-bottom">
        &copy; <%= year %> RoIron. All rights reserved.
      </div>
    </div>
  </footer>
</body>
</html>
