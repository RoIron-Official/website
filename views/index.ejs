<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/icon.png">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="hero">
            <div class="container">
                <div class="hero-content">
                    <div class="hero-text">
                        <div class="hero-badge">
                            <span class="badge-dot"></span>
                            <span>v<%= version %> · Available Now</span>
                        </div>
                        <h1>RoIron<br><span>Roblox Optimizer</span></h1>
                        <p>Lightweight Roblox enhancement tool with focus on performance and privacy.</p>
                        <div class="hero-actions">
                            <a href="/download" class="btn btn-primary">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16V20H20V16"/><path d="M12 4V14M12 14L9 11M12 14L15 11"/></svg>
                                Download Extension
                            </a>
                            <a href="/features" class="btn btn-outline">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                                Learn More
                            </a>
                        </div>
                    </div>
                    <div class="hero-card">
                        <div class="hero-card-header">
                            <span class="hero-card-dots">
                                <span></span><span></span><span></span>
                            </span>
                            <span>RoIron v<%= version %></span>
                        </div>
                        <div class="hero-card-body">
                            <div class="hero-card-stats">
                                <div>
                                    <span class="stat-value">50+</span>
                                    <span class="stat-label">Features</span>
                                </div>
                                <div>
                                    <span class="stat-value">100%</span>
                                    <span class="stat-label">Privacy</span>
                                </div>
                                <div>
                                    <span class="stat-value">1.3.9</span>
                                    <span class="stat-label">Version</span>
                                </div>
                            </div>
                            <div class="hero-card-features">
                                <span>#Performance</span>
                                <span>#Privacy</span>
                                <span>#Lightweight</span>
                                <span>#OpenSource</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <div class="section-header">
                    <h2>Why RoIron?</h2>
                    <p>Everything you need to enhance your Roblox experience</p>
                </div>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14H12L11 22L20 10H12L13 2Z"/></svg>
                        </div>
                        <h3>Performance</h3>
                        <p>Lightweight and fast — no unnecessary bloat.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V11"/></svg>
                        </div>
                        <h3>Privacy First</h3>
                        <p>Your data stays yours. No tracking, no selling.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2C12 6 16 8 16 12C16 16 12 18 12 22"/><path d="M12 2C12 6 8 8 8 12C8 16 12 18 12 22"/><path d="M4 8H20"/><path d="M4 16H20"/></svg>
                        </div>
                        <h3>Custom Themes</h3>
                        <p>Full theme customization with built-in editor.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L4 5V12C4 16.5 7 20.5 12 22C17 20.5 20 16.5 20 12V5L12 2Z"/><path d="M9 12L11 14L15 10"/></svg>
                        </div>
                        <h3>Ad Blocker</h3>
                        <p>Block annoying ads and tracking scripts.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4H18V8C18 10 17 12 15 13.5C13.5 15 12 15.5 12 15.5C12 15.5 10.5 15 9 13.5C7 12 6 10 6 8V4Z"/><path d="M6 4H4V7C4 8.5 5 9.5 6 10"/><path d="M18 4H20V7C20 8.5 19 9.5 18 10"/><path d="M12 15.5V20"/><path d="M9 20H15"/></svg>
                        </div>
                        <h3>Leaderboards</h3>
                        <p>Compete with friends and track your progress.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C12 2 8 6 8 12C8 15 10 18 12 20C14 18 16 15 16 12C16 6 12 2 12 2Z"/><path d="M12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9Z"/><path d="M8 12H4"/><path d="M20 12H16"/><path d="M12 8V4"/><path d="M12 20V16"/></svg>
                        </div>
                        <h3>Quick Actions</h3>
                        <p>Join games faster with Play and Random buttons.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
