<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>All Features</h2>
        <p>Everything RoIron has to offer</p>
      </div>
      <div class="features-grid" style="grid-template-columns:1fr 1fr;">
        <div class="feature-card"><h3>🚀 Ad Blocker</h3><p>Blocks ads, analytics, and tracking scripts for a clean experience.</p></div>
        <div class="feature-card"><h3>🌙 Dark Theme</h3><p>Fully customizable dark theme for all Roblox pages.</p></div>
        <div class="feature-card"><h3>🏆 XP & Leveling</h3><p>Earn XP for playing, track your level, and compete on leaderboards.</p></div>
        <div class="feature-card"><h3>👥 Friend Status</h3><p>See online status of your friends directly on their avatars.</p></div>
        <div class="feature-card"><h3>🎨 Avatar Customizer</h3><p>Glow, Fire, Rainbow, Galaxy, Diamond effects for your avatar.</p></div>
        <div class="feature-card"><h3>🌍 Server Region</h3><p>See server region and join random servers with one click.</p></div>
        <div class="feature-card"><h3>🖼️ Image Optimizer</h3><p>Lazy loading for images, faster page loads.</p></div>
        <div class="feature-card"><h3>⌨️ Keyboard Shortcuts</h3><p>Alt+R for home, Alt+S for settings.</p></div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
