<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="section">
            <div class="container">
                <div class="section-header">
                    <h2>All Features</h2>
                    <p>Everything RoIron has to offer</p>
                </div>
                <div class="features-grid" style="grid-template-columns: repeat(2, 1fr);">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'code', class: 'icon-xl' }) %>
                        </div>
                        <h3>Core Modules</h3>
                        <p>Activity Tracker, Game Status, Game Page enhancements, Game Cards, Buttons, Images, Shortcuts, User Badge, Friend Status, Server Region, Avatar Preview, Search, Navigation, Game Launcher.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'palette', class: 'icon-xl' }) %>
                        </div>
                        <h3>Theme Creator</h3>
                        <p>Create and apply custom themes with real-time preview. Edit colors, sizes, spacing, and more.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'star', class: 'icon-xl' }) %>
                        </div>
                        <h3>Avatar Customizer</h3>
                        <p>Customize your avatar with special effects: Glow, Fire, Rainbow, Galaxy, Diamond.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'users', class: 'icon-xl' }) %>
                        </div>
                        <h3>Profile Override</h3>
                        <p>Minimalistic profile view with only essential stats: Games, Badges, Groups, Inventory, Trade.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'trophy', class: 'icon-xl' }) %>
                        </div>
                        <h3>Leaderboards</h3>
                        <p>Track XP, Level, and Playtime. Compete with other RoIron users.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'settings', class: 'icon-xl' }) %>
                        </div>
                        <h3>Admin Panel</h3>
                        <p>Manage licenses and users. Available only for authorized admins.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'server', class: 'icon-xl' }) %>
                        </div>
                        <h3>Server Region</h3>
                        <p>Display server region information for game servers.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <%- include('partials/icons', { icon: 'gamepad', class: 'icon-xl' }) %>
                        </div>
                        <h3>Friend Status</h3>
                        <p>See online status of your friends with beautiful visual indicators.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
