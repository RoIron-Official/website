<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Database Stats - RoIron</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/icon.png">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="section">
            <div class="container">
                <div class="section-header">
                    <h2>Database Statistics</h2>
                    <p>Real-time stats from RoIron database</p>
                </div>

                <div id="stats-container" style="max-width: 800px; margin: 0 auto;">
                    <div style="text-align: center; padding: 40px; color: #666666;">
                        <div style="display: inline-block; width: 24px; height: 24px; border: 2px solid rgba(255,255,255,0.1); border-top: 2px solid #4a9eff; border-radius: 50%; animation: roiron-spin 0.8s linear infinite; margin-bottom: 12px;"></div>
                        <div>Loading stats...</div>
                    </div>
                </div>

                <div style="margin-top: 24px; text-align: center;">
                    <button id="refresh-stats" style="padding: 10px 28px; background: #4a9eff; border: none; border-radius: 8px; color: #ffffff; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.3s ease;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 6px;"><path d="M21 12C21 13.1819 20.7672 14.3522 20.3149 15.4442C19.8626 16.5361 19.1997 17.5282 18.364 18.364C17.5282 19.1997 16.5361 19.8626 15.4442 20.3149C14.3522 20.7672 13.1819 21 12 21C10.8181 21 9.64778 20.7672 8.55585 20.3149C7.46392 19.8626 6.47177 19.1997 5.63604 18.364C4.80031 17.5282 4.13738 16.5361 3.68508 15.4442C3.23279 14.3522 3 13.1819 3 12"/><path d="M3 3V9H9"/></svg>
                        Refresh
                    </button>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <style>
        @keyframes roiron-spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .stat-number {
            font-variant-numeric: tabular-nums;
        }
    </style>

    <script>
        async function loadStats() {
            const container = document.getElementById('stats-container');
            
            try {
                const response = await fetch('/api/db/stats');
                const data = await response.json();

                if (data.success) {
                    container.innerHTML = `
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px;">
                            <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px; text-align: center;">
                                <div style="font-size: 36px; font-weight: 800; color: #4a9eff;" class="stat-number">${data.users || 0}</div>
                                <div style="font-size: 12px; color: #888888; margin-top: 4px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 4px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    Total Users
                                </div>
                            </div>
                            <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px; text-align: center;">
                                <div style="font-size: 36px; font-weight: 800; color: #4CAF50;" class="stat-number">${data.active_users || 0}</div>
                                <div style="font-size: 12px; color: #888888; margin-top: 4px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4CAF50" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 4px;"><circle cx="12" cy="12" r="10"/><path d="M12 6V12L16 14"/></svg>
                                    Active Users
                                </div>
                            </div>
                            <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px; text-align: center;">
                                <div style="font-size: 36px; font-weight: 800; color: #ffd700;" class="stat-number">${data.licenses || 0}</div>
                                <div style="font-size: 12px; color: #888888; margin-top: 4px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ffd700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 4px;"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V11"/></svg>
                                    Active Licenses
                                </div>
                            </div>
                            <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px; text-align: center;">
                                <div style="font-size: 36px; font-weight: 800; color: #FF9800;" class="stat-number">${data.active_sessions || 0}</div>
                                <div style="font-size: 12px; color: #888888; margin-top: 4px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF9800" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 4px;"><path d="M12 2C12 2 8 6 8 12C8 15 10 18 12 20C14 18 16 15 16 12C16 6 12 2 12 2Z"/><path d="M12 9C10.3431 9 9 10.3431 9 12C9 13.6569 10.3431 15 12 15C13.6569 15 15 13.6569 15 12C15 10.3431 13.6569 9 12 9Z"/></svg>
                                    Active Sessions
                                </div>
                            </div>
                        </div>

                        <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px;">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                                <div style="padding: 8px 12px; background: rgba(255,255,255,0.02); border-radius: 6px;">
                                    <div style="font-size: 11px; color: #666666;">Total XP</div>
                                    <div style="font-size: 18px; font-weight: 700; color: #ffffff;" class="stat-number">${(data.total_xp || 0).toLocaleString()}</div>
                                </div>
                                <div style="padding: 8px 12px; background: rgba(255,255,255,0.02); border-radius: 6px;">
                                    <div style="font-size: 11px; color: #666666;">Avg Level</div>
                                    <div style="font-size: 18px; font-weight: 700; color: #ffffff;" class="stat-number">${data.avg_level || 0}</div>
                                </div>
                                <div style="padding: 8px 12px; background: rgba(255,255,255,0.02); border-radius: 6px;">
                                    <div style="font-size: 11px; color: #666666;">Total Playtime</div>
                                    <div style="font-size: 18px; font-weight: 700; color: #ffffff;" class="stat-number">${data.total_playtime || 0}h</div>
                                </div>
                                <div style="padding: 8px 12px; background: rgba(255,255,255,0.02); border-radius: 6px;">
                                    <div style="font-size: 11px; color: #666666;">Database</div>
                                    <div style="font-size: 18px; font-weight: 700; color: #4a9eff;">${data.db_type || 'MySQL'}</div>
                                </div>
                            </div>
                        </div>

                        <div style="margin-top: 16px; font-size: 12px; color: #444444; text-align: center;">
                            Last updated: ${data.updated_at ? new Date(data.updated_at).toLocaleString() : 'Just now'}
                        </div>
                    `;
                } else {
                    container.innerHTML = `
                        <div style="text-align: center; padding: 40px; color: #ff6b6b;">
                            <div style="font-size: 48px; margin-bottom: 12px;">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ff6b6b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8V12M12 16H12.01"/></svg>
                            </div>
                            <div style="font-size: 16px;">Failed to load stats</div>
                            <div style="font-size: 13px; color: #666666; margin-top: 4px;">${data.error || 'Unknown error'}</div>
                        </div>
                    `;
                }
            } catch (error) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 40px; color: #ff6b6b;">
                        <div style="font-size: 48px; margin-bottom: 12px;">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ff6b6b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4L20 20M20 4L4 20"/></svg>
                        </div>
                        <div style="font-size: 16px;">Connection error</div>
                        <div style="font-size: 13px; color: #666666; margin-top: 4px;">${error.message}</div>
                    </div>
                `;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            loadStats();

            document.getElementById('refresh-stats').addEventListener('click', function() {
                this.disabled = true;
                this.innerHTML = `
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 6px; animation: roiron-spin 0.8s linear infinite;"><path d="M21 12C21 13.1819 20.7672 14.3522 20.3149 15.4442C19.8626 16.5361 19.1997 17.5282 18.364 18.364C17.5282 19.1997 16.5361 19.8626 15.4442 20.3149C14.3522 20.7672 13.1819 21 12 21C10.8181 21 9.64778 20.7672 8.55585 20.3149C7.46392 19.8626 6.47177 19.1997 5.63604 18.364C4.80031 17.5282 4.13738 16.5361 3.68508 15.4442C3.23279 14.3522 3 13.1819 3 12"/><path d="M3 3V9H9"/></svg>
                    Loading...
                `;
                this.style.opacity = '0.7';
                
                loadStats().then(() => {
                    this.disabled = false;
                    this.innerHTML = `
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display: inline; vertical-align: middle; margin-right: 6px;"><path d="M21 12C21 13.1819 20.7672 14.3522 20.3149 15.4442C19.8626 16.5361 19.1997 17.5282 18.364 18.364C17.5282 19.1997 16.5361 19.8626 15.4442 20.3149C14.3522 20.7672 13.1819 21 12 21C10.8181 21 9.64778 20.7672 8.55585 20.3149C7.46392 19.8626 6.47177 19.1997 5.63604 18.364C4.80031 17.5282 4.13738 16.5361 3.68508 15.4442C3.23279 14.3522 3 13.1819 3 12"/><path d="M3 3V9H9"/></svg>
                        Refresh
                    `;
                    this.style.opacity = '1';
                });
            });
        });
    </script>
</body>
</html>
