<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>

    <main>
        <section class="section">
            <div class="container">
                <div class="section-header">
                    <h2>Download RoIron</h2>
                    <p>Get the latest version</p>
                </div>
                <div style="max-width: 600px; margin: 0 auto; text-align: center;">
                    <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 40px; margin-bottom: 20px;">
                        <div class="feature-icon" style="margin-bottom: 16px;">
                            <%- include('partials/icons', { icon: 'download', class: 'icon-xxl' }) %>
                        </div>
                        <h3 style="color: #ffffff; font-size: 24px; margin-bottom: 8px;">RoIron Extension</h3>
                        <p style="color: #888888; font-size: 14px; margin-bottom: 24px;">Version <%= version %></p>
                        <a href="/download/roiron.crx" class="btn btn-primary" style="font-size: 16px; padding: 14px 40px;">
                            <%- include('partials/icons', { icon: 'download', class: 'icon-sm' }) %>
                            Download .crx
                        </a>
                        <p style="color: #666666; font-size: 12px; margin-top: 16px;">
                            Compatible with Chrome and Brave browsers
                        </p>
                    </div>

                    <div style="background: #1a1a1a; border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 24px;">
                        <h4 style="color: #cccccc; font-size: 14px; margin-bottom: 8px;">
                            <%- include('partials/icons', { icon: 'info', class: 'icon-sm' }) %>
                            Installation Guide
                        </h4>
                        <ol style="color: #888888; font-size: 13px; text-align: left; padding-left: 20px; line-height: 2;">
                            <li>Download the <code style="background: rgba(255,255,255,0.04); padding: 2px 8px; border-radius: 4px; color: #4a9eff;">roiron.crx</code> file</li>
                            <li>Open Chrome and go to <code style="background: rgba(255,255,255,0.04); padding: 2px 8px; border-radius: 4px; color: #4a9eff;">chrome://extensions/</code></li>
                            <li>Enable <strong style="color: #ffffff;">Developer mode</strong> (toggle in top right)</li>
                            <li>Drag and drop the <code style="background: rgba(255,255,255,0.04); padding: 2px 8px; border-radius: 4px; color: #4a9eff;">roiron.crx</code> file into the page</li>
                            <li>Click <strong style="color: #ffffff;">Add extension</strong> and you're done!</li>
                        </ol>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
