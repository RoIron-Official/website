<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/icons.css" />
</head>
<body>
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <span class="icon icon-lg icon-white">
          <svg viewBox="0 0 128 128" fill="none">
            <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
            <rect x="4" y="4" width="120" height="120" rx="24" stroke="currentColor" stroke-width="2.5"/>
            <text x="64" y="82" font-size="52" font-weight="700" fill="currentColor" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif">RI</text>
          </svg>
        </span>
        RoIron
      </a>
      <nav class="nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/features" class="nav-link">Features</a>
        <a href="/docs" class="nav-link">Docs</a>
        <a href="/login" class="nav-link">Login</a>
      </nav>
    </div>
  </header>

  <main style="padding:80px 20px;text-align:center;">
    <div class="container" style="max-width:600px;">
      <span class="icon icon-xxl icon-primary" style="display:block;margin:0 auto 24px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
      </span>
      <h1 style="font-size:36px;font-weight:700;color:#ffffff;margin:0 0 8px;">Download RoIron</h1>
      <p style="font-size:18px;color:#888888;margin:0 0 32px;">Get the latest version of the extension</p>

      <div style="background:#141414;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:32px;">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;background:rgba(255,255,255,0.02);border-radius:8px;border:1px solid rgba(255,255,255,0.04);">
          <div style="text-align:left;">
            <div style="font-weight:600;color:#ffffff;">RoIron Extension v<%= version %></div>
            <div style="font-size:13px;color:#888888;">Chrome / Edge / Brave</div>
          </div>
          <a href="#" class="btn btn-primary" style="padding:10px 24px;font-size:14px;">Download .zip</a>
        </div>

        <div style="margin-top:16px;padding:12px 16px;background:rgba(74,158,255,0.05);border-radius:6px;border:1px solid rgba(74,158,255,0.1);font-size:13px;color:#888888;text-align:left;">
          <strong style="color:#4a9eff;">How to install:</strong>
          <ol style="margin:8px 0 0 20px;padding:0;">
            <li>Download the .zip file</li>
            <li>Extract the folder</li>
            <li>Open Chrome extensions (chrome://extensions/)</li>
            <li>Enable "Developer mode"</li>
            <li>Click "Load unpacked" and select the extracted folder</li>
          </ol>
        </div>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-bottom">
        &copy; <%= year %> RoIron. All rights reserved.
      </div>
    </div>
  </footer>
</body>
</html>
