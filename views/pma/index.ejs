<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .pma-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      vertical-align: middle;
    }
    .pma-icon svg {
      width: 100%;
      height: 100%;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .pma-icon-sm { width: 16px; height: 16px; }
    .pma-icon-lg { width: 24px; height: 24px; }
    .pma-icon-xl { width: 32px; height: 32px; }

    .pma-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 0;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 8px;
    }
    .pma-header h1 {
      font-size: 24px;
      font-weight: 700;
      color: #ffffff;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .pma-header .actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .pma-header .actions .badge {
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
      background: rgba(74,158,255,0.15);
      color: #4a9eff;
      border: 1px solid rgba(74,158,255,0.2);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .pma-header .actions .logout-btn {
      padding: 6px 16px;
      background: rgba(255,50,50,0.1);
      border: 1px solid rgba(255,50,50,0.2);
      border-radius: 6px;
      color: #ff6b6b;
      font-size: 13px;
      text-decoration: none;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .pma-header .actions .logout-btn:hover {
      background: rgba(255,50,50,0.2);
    }
    .pma-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 12px;
      margin-bottom: 24px;
    }
    .pma-stats .stat {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.04);
      border-radius: 8px;
      padding: 12px 16px;
      text-align: center;
    }
    .pma-stats .stat .value {
      font-size: 22px;
      font-weight: 700;
      color: #4a9eff;
    }
    .pma-stats .stat .label {
      font-size: 11px;
      color: #666666;
      margin-top: 2px;
    }
    .pma-tables {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.04);
      border-radius: 8px;
      padding: 16px;
    }
    .pma-tables h2 {
      font-size: 16px;
      font-weight: 600;
      color: #ffffff;
      margin: 0 0 12px 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pma-tables .table-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.04);
      border-radius: 6px;
      margin-bottom: 4px;
      transition: all 0.3s ease;
      text-decoration: none;
      color: inherit;
    }
    .pma-tables .table-item:hover {
      background: rgba(255,255,255,0.04);
      border-color: rgba(255,255,255,0.08);
    }
    .pma-tables .table-item .name {
      font-size: 14px;
      font-weight: 500;
      color: #cccccc;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pma-tables .table-item .name .icon {
      color: #4a9eff;
    }
    .pma-tables .table-item .rows {
      font-size: 12px;
      color: #666666;
    }
    .pma-tables .empty {
      text-align: center;
      padding: 20px;
      color: #666666;
      font-size: 13px;
    }
    .pma-query {
      margin-top: 16px;
    }
    .pma-query textarea {
      width: 100%;
      min-height: 80px;
      padding: 12px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 6px;
      color: #ffffff;
      font-size: 13px;
      font-family: 'SF Mono', 'Menlo', 'Monaco', monospace;
      outline: none;
      resize: vertical;
    }
    .pma-query textarea:focus {
      border-color: #4a9eff;
    }
    .pma-query .query-actions {
      display: flex;
      gap: 8px;
      margin-top: 8px;
    }
    .pma-query .query-actions button {
      padding: 8px 20px;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .pma-query .query-actions .btn-run {
      background: #4a9eff;
      color: #ffffff;
    }
    .pma-query .query-actions .btn-run:hover {
      background: #3a7acc;
    }
    .pma-query .query-actions .btn-clear {
      background: rgba(255,255,255,0.06);
      color: #cccccc;
    }
    .pma-query .query-actions .btn-clear:hover {
      background: rgba(255,255,255,0.1);
    }
    .pma-query .query-result {
      margin-top: 12px;
      padding: 12px;
      background: rgba(0,0,0,0.3);
      border: 1px solid rgba(255,255,255,0.04);
      border-radius: 6px;
      font-size: 12px;
      font-family: 'SF Mono', 'Menlo', 'Monaco', monospace;
      color: #cccccc;
      white-space: pre-wrap;
      word-break: break-all;
      max-height: 300px;
      overflow-y: auto;
      display: none;
    }
    .pma-query .query-result.show {
      display: block;
    }
    .pma-query .query-result .error {
      color: #ff6b6b;
    }
    .pma-query .query-result .success {
      color: #4CAF50;
    }
    @media (max-width: 768px) {
      .pma-header {
        flex-direction: column;
        align-items: flex-start;
      }
      .pma-header .actions {
        width: 100%;
        flex-wrap: wrap;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="pma-header">
      <h1>
        <span class="pma-icon">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
        </span>
        Database Manager
        <span class="badge" style="font-size:12px;margin-left:8px;display:inline-flex;align-items:center;gap:4px;">
          <span class="pma-icon pma-icon-sm">
            <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
          </span>
          <%= db_type %>
        </span>
      </h1>
      <div class="actions">
        <span class="badge">
          <span class="pma-icon pma-icon-sm">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 20v-2a7 7 0 0 1 14 0v2"/></svg>
          </span>
          <%= user?.pma_username || 'Administrator' %>
        </span>
        <a href="/pma/logout" class="logout-btn">
          <span class="pma-icon pma-icon-sm">
            <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </span>
          Logout
        </a>
      </div>
    </div>

    <div class="pma-stats">
      <div class="stat">
        <div class="value"><%= tables.length %></div>
        <div class="label">Tables</div>
      </div>
      <div class="stat">
        <div class="value"><%= tables.reduce((sum, t) => sum + t.rows, 0) %></div>
        <div class="label">Total Rows</div>
      </div>
      <div class="stat">
        <div class="value"><%= db_type %></div>
        <div class="label">Database Type</div>
      </div>
    </div>

    <div class="pma-tables">
      <h2>
        <span class="pma-icon">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="21" x2="9" y2="9"/><line x1="15" y1="21" x2="15" y2="9"/></svg>
        </span>
        Tables
      </h2>
      <% if (tables && tables.length > 0) { %>
        <% tables.forEach(table => { %>
          <a href="/pma/table/<%= table.name %>" class="table-item">
            <span class="name">
              <span class="icon pma-icon">
                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="21" x2="9" y2="9"/><line x1="15" y1="21" x2="15" y2="9"/></svg>
              </span>
              <%= table.name %>
            </span>
            <span class="rows"><%= table.rows %> rows</span>
          </a>
        <% }) %>
      <% } else { %>
        <div class="empty">
          <%= error || 'No tables found' %>
        </div>
      <% } %>
    </div>

    <div class="pma-query">
      <h2 style="font-size:14px;font-weight:600;color:#ffffff;margin:16px 0 8px;display:flex;align-items:center;gap:8px;">
        <span class="pma-icon">
          <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </span>
        Custom Query
      </h2>
      <textarea id="pma-query-input" placeholder="SELECT * FROM users LIMIT 10"></textarea>
      <div class="query-actions">
        <button class="btn-run" id="pma-query-run">
          <span class="pma-icon pma-icon-sm">
            <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </span>
          Run
        </button>
        <button class="btn-clear" id="pma-query-clear">
          <span class="pma-icon pma-icon-sm">
            <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </span>
          Clear
        </button>
      </div>
      <div class="query-result" id="pma-query-result"></div>
    </div>

    <div style="margin-top:24px;padding-top:12px;border-top:1px solid rgba(255,255,255,0.04);font-size:11px;color:#333333;text-align:center;display:flex;align-items:center;justify-content:center;gap:8px;">
      <span class="pma-icon pma-icon-sm" style="color:#333333;">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </span>
      RoIron PMA · <%= year %>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const queryInput = document.getElementById('pma-query-input');
      const runBtn = document.getElementById('pma-query-run');
      const clearBtn = document.getElementById('pma-query-clear');
      const resultDiv = document.getElementById('pma-query-result');

      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      function formatJson(data) {
        try {
          return JSON.stringify(data, null, 2);
        } catch (e) {
          return String(data);
        }
      }

      runBtn.addEventListener('click', async function() {
        const sql = queryInput.value.trim();
        if (!sql) {
          resultDiv.className = 'query-result show';
          resultDiv.innerHTML = '<span class="error">Please enter a query</span>';
          return;
        }

        const lowerSql = sql.toLowerCase();
        if (lowerSql.includes('drop') && !lowerSql.includes('drop table if exists')) {
          if (!confirm('⚠️ Your query contains DROP. Are you sure?')) return;
        }

        resultDiv.className = 'query-result show';
        resultDiv.innerHTML = '<span style="color:#4a9eff;">⏳ Running query...</span>';

        try {
          const response = await fetch('/pma/api/query', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sql: sql })
          });

          const data = await response.json();

          if (data.success) {
            const count = data.data ? data.data.length : 0;
            resultDiv.innerHTML = `
              <span class="success">✅ Query executed successfully (${count} rows)</span>
              <br /><br />
              ${formatJson(data.data)}
            `;
          } else {
            resultDiv.innerHTML = `<span class="error">❌ Error: ${escapeHtml(data.error)}</span>`;
          }
        } catch (error) {
          resultDiv.innerHTML = `<span class="error">❌ Network error: ${escapeHtml(error.message)}</span>`;
        }
      });

      clearBtn.addEventListener('click', function() {
        queryInput.value = '';
        resultDiv.className = 'query-result';
        resultDiv.innerHTML = '';
      });

      queryInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          runBtn.click();
        }
      });
    });
  </script>
</body>
</html>
