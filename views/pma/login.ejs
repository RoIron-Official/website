<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .pma-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      vertical-align: middle;
    }
    .pma-icon svg {
      width: 100%;
      height: 100%;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .pma-icon-lg { width: 48px; height: 48px; }

    .pma-login-container {
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }
    .pma-login-box {
      max-width: 400px;
      width: 100%;
      background: #1a1a1a;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 40px 32px;
    }
    .pma-login-box .logo {
      text-align: center;
      margin-bottom: 28px;
    }
    .pma-login-box .logo .icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      height: 64px;
      background: rgba(74,158,255,0.1);
      border-radius: 16px;
      margin-bottom: 12px;
      color: #4a9eff;
    }
    .pma-login-box .logo .icon svg {
      width: 32px;
      height: 32px;
      stroke-width: 1.8;
    }
    .pma-login-box .logo h1 {
      font-size: 28px;
      font-weight: 700;
      color: #4a9eff;
      margin: 0;
    }
    .pma-login-box .logo p {
      font-size: 14px;
      color: #666666;
      margin: 4px 0 0;
    }
    .pma-login-box .form-group {
      margin-bottom: 16px;
    }
    .pma-login-box .form-group label {
      display: block;
      font-size: 13px;
      color: #888888;
      margin-bottom: 4px;
    }
    .pma-login-box .form-group .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }
    .pma-login-box .form-group .input-wrapper .icon {
      position: absolute;
      left: 12px;
      color: #666666;
      width: 18px;
      height: 18px;
    }
    .pma-login-box .form-group .input-wrapper input {
      width: 100%;
      padding: 10px 14px 10px 40px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 6px;
      color: #ffffff;
      font-size: 14px;
      outline: none;
      transition: border-color 0.3s ease;
    }
    .pma-login-box .form-group .input-wrapper input:focus {
      border-color: #4a9eff;
    }
    .pma-login-box .error {
      background: rgba(255,50,50,0.1);
      border: 1px solid rgba(255,50,50,0.2);
      border-radius: 6px;
      padding: 10px 14px;
      color: #ff6b6b;
      font-size: 13px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pma-login-box .error .icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }
    .pma-login-box .btn {
      width: 100%;
      padding: 12px;
      background: #4a9eff;
      border: none;
      border-radius: 6px;
      color: #ffffff;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .pma-login-box .btn:hover {
      background: #3a7acc;
      transform: translateY(-1px);
    }
    .pma-login-box .btn .icon {
      width: 18px;
      height: 18px;
    }
    .pma-login-box .footer {
      text-align: center;
      margin-top: 20px;
      font-size: 12px;
      color: #444444;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .pma-login-box .footer .icon {
      width: 14px;
      height: 14px;
      color: #333333;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="pma-login-container">
      <div class="pma-login-box">
        <div class="logo">
          <div class="icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
          </div>
          <h1>PMA</h1>
          <p>Database Management</p>
        </div>
        
        <% if (error) { %>
          <div class="error">
            <span class="icon">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </span>
            <%= error %>
          </div>
        <% } %>
        
        <form method="POST" action="/pma/login">
          <div class="form-group">
            <label for="username">Username</label>
            <div class="input-wrapper">
              <span class="icon">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 20v-2a7 7 0 0 1 14 0v2"/></svg>
              </span>
              <input type="text" id="username" name="username" placeholder="Enter username" required autofocus />
            </div>
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-wrapper">
              <span class="icon">
                <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" id="password" name="password" placeholder="Enter password" required />
            </div>
          </div>
          <button type="submit" class="btn">
            <span class="icon">
              <svg viewBox="0 0 24 24"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
            </span>
            Login
          </button>
        </form>
        
        <div class="footer">
          <span class="icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <span>RoIron PMA</span>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
