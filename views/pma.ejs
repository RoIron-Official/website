<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RoIron Database Manager</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/icons.css" />
  <style>
    .pma-container {
      padding: 20px;
      max-width: 1400px;
      margin: 0 auto;
    }
    .pma-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 24px;
      background: #141414;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .pma-header h1 {
      font-size: 20px;
      font-weight: 700;
      color: #ffffff;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .pma-login {
      max-width: 400px;
      margin: 80px auto;
      background: #141414;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 40px;
    }
    .pma-login .logo-wrap {
      text-align: center;
      margin-bottom: 20px;
    }
    .pma-login h2 {
      font-size: 22px;
      font-weight: 700;
      color: #ffffff;
      text-align: center;
      margin: 0 0 4px;
    }
    .pma-login .sub {
      text-align: center;
      color: #888888;
      font-size: 14px;
      margin-bottom: 28px;
    }
    .pma-login label {
      font-size: 13px;
      color: #888888;
      display: block;
      margin-bottom: 4px;
      font-weight: 500;
    }
    .pma-login input {
      width: 100%;
      padding: 12px 16px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      color: #ffffff;
      font-size: 14px;
      font-family: 'SF Mono', 'Menlo', monospace;
      outline: none;
      transition: border 0.3s ease;
      margin-bottom: 16px;
    }
    .pma-login input:focus {
      border-color: #4a9eff;
      box-shadow: 0 0 0 3px rgba(74,158,255,0.1);
    }
    .pma-login .error {
      color: #ff6b6b;
      font-size: 13px;
      margin-bottom: 12px;
      display: none;
      padding: 8px 12px;
      background: rgba(255,50,50,0.08);
      border-radius: 6px;
      border: 1px solid rgba(255,50,50,0.12);
    }
    .pma-login .btn-login {
      width: 100%;
      padding: 12px;
      background: #4a9eff;
      border: none;
      border-radius: 8px;
      color: #ffffff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .pma-login .btn-login:hover {
      background: #3a7acc;
      transform: translateY(-1px);
    }
    .pma-login .btn-login:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }
    .pma-login .footer-text {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,0.04);
      font-size: 12px;
      color: #444444;
      text-align: center;
    }
    .pma-table-wrap {
      background: #141414;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 16px;
    }
    .pma-table-wrap .table-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: rgba(255,255,255,0.02);
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .pma-table-wrap .table-header h3 {
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .pma-table-wrap .table-header .count {
      font-size: 12px;
      color: #666666;
      background: rgba(255,255,255,0.04);
      padding: 2px 10px;
      border-radius: 12px;
    }
    .pma-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    .pma-table th {
      text-align: left;
      padding: 8px 12px;
      background: rgba(255,255,255,0.03);
      color: #888888;
      font-weight: 500;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid rgba(255,255,255,0.06);
      position: sticky;
      top: 0;
    }
    .pma-table td {
      padding: 6px 12px;
      color: #cccccc;
      border-bottom: 1px solid rgba(255,255,255,0.03);
      font-family: 'SF Mono', 'Menlo', monospace;
      font-size: 12px;
      word-break: break-all;
      max-width: 300px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .pma-table tr:hover td {
      background: rgba(255,255,255,0.02);
    }
    .pma-table .id-col {
      color: #4a9eff;
      font-weight: 500;
    }
    .pma-table .null {
      color: #444444;
      font-style: italic;
    }
    .pma-table .active-yes {
      color: #4CAF50;
    }
    .pma-table .active-no {
      color: #ff6b6b;
    }
    .pma-refresh {
      padding: 6px 16px;
      background: rgba(74,158,255,0.1);
      border: 1px solid rgba(74,158,255,0.2);
      border-radius: 6px;
      color: #4a9eff;
      cursor: pointer;
      font-size: 12px;
      font-weight: 500;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .pma-refresh:hover {
      background: rgba(74,158,255,0.2);
    }
    .pma-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }
    .pma-tab {
      padding: 8px 18px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 8px;
      color: #888888;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .pma-tab:hover {
      background: rgba(255,255,255,0.08);
      color: #ffffff;
    }
    .pma-tab.active {
      background: rgba(74,158,255,0.15);
      border-color: rgba(74,158,255,0.25);
      color: #4a9eff;
    }
    .pma-tab .badge {
      background: rgba(74,158,255,0.15);
      padding: 1px 8px;
      border-radius: 10px;
      font-size: 10px;
      font-weight: 600;
    }
    .pma-tab.active .badge {
      background: rgba(74,158,255,0.2);
    }
    .pma-logout {
      padding: 6px 16px;
      background: rgba(255,50,50,0.1);
      border: 1px solid rgba(255,50,50,0.2);
      border-radius: 6px;
      color: #ff6b6b;
      cursor: pointer;
      font-size: 12px;
      font-weight: 500;
      transition: all 0.3s ease;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .pma-logout:hover {
      background: rgba(255,50,50,0.2);
    }
    .pma-status {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: #666666;
    }
    .pma-status .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      display: inline-block;
    }
    .pma-status .dot.online {
      background: #4CAF50;
    }
    .pma-status .dot.offline {
      background: #ff6b6b;
    }
    .pma-empty {
      text-align: center;
      padding: 40px;
      color: #666666;
      font-size: 14px;
    }
    .pma-empty .icon {
      display: block;
      margin: 0 auto 12px;
      color: #444444;
    }
    .pma-actions {
      display: flex;
      gap: 4px;
    }
    .pma-actions button {
      padding: 2px 10px;
      border: none;
      border-radius: 4px;
      font-size: 10px;
      cursor: pointer;
      transition: all 0.2s ease;
      font-weight: 500;
    }
    .pma-actions .delete {
      background: rgba(255,50,50,0.15);
      color: #ff6b6b;
    }
    .pma-actions .delete:hover {
      background: rgba(255,50,50,0.25);
    }
    .pma-actions .edit {
      background: rgba(74,158,255,0.15);
      color: #4a9eff;
    }
    .pma-actions .edit:hover {
      background: rgba(74,158,255,0.25);
    }
    .pma-error-box {
      background: rgba(255,50,50,0.08);
      border: 1px solid rgba(255,50,50,0.15);
      border-radius: 8px;
      padding: 12px 16px;
      color: #ff6b6b;
      text-align: center;
      margin-bottom: 16px;
      font-size: 13px;
    }
    .pma-loading {
      text-align: center;
      padding: 40px;
      color: #666666;
      font-size: 14px;
    }
    .pma-loading .spinner {
      display: inline-block;
      width: 24px;
      height: 24px;
      border: 2px solid rgba(255,255,255,0.06);
      border-top: 2px solid #4a9eff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-bottom: 12px;
    }
    .pma-table-wrap .empty-state {
      padding: 30px;
      text-align: center;
      color: #666666;
      font-size: 14px;
    }
    .pma-table-wrap .empty-state .icon {
      display: block;
      margin: 0 auto 12px;
      color: #444444;
      font-size: 32px;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    @media (max-width: 768px) {
      .pma-table {
        font-size: 11px;
      }
      .pma-table th, .pma-table td {
        padding: 4px 6px;
        font-size: 10px;
      }
      .pma-header {
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
      }
      .pma-header h1 {
        font-size: 17px;
      }
      .pma-login {
        padding: 24px;
        margin: 40px auto;
      }
    }
  </style>
</head>
<body>
  <div id="app">
    <!-- Login Form -->
    <div id="pma-login" style="display:none;">
      <div class="pma-login">
        <div class="logo-wrap">
          <span class="icon icon-xl icon-primary">
            <svg viewBox="0 0 128 128" fill="none">
              <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
              <rect x="4" y="4" width="120" height="120" rx="24" stroke="currentColor" stroke-width="2.5"/>
              <text x="64" y="82" font-size="52" font-weight="700" fill="currentColor" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif">RI</text>
            </svg>
          </span>
        </div>
        <h2>Database Manager</h2>
        <p class="sub">Enter your credentials to access</p>
        <form id="login-form-pma">
          <label for="pma-user">Username</label>
          <input type="text" id="pma-user" name="username" placeholder="admin" value="admin" autocomplete="username" />
          <label for="pma-pass">Password</label>
          <input type="password" id="pma-pass" name="password" placeholder="Enter password" autocomplete="current-password" />
          <div class="error" id="pma-error">Invalid credentials</div>
          <button type="submit" class="btn-login">
            <span class="icon icon-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg></span>
            Login
          </button>
        </form>
        <div class="footer-text">
          RoIron Database Manager &bull; v1.0
        </div>
      </div>
    </div>

    <!-- Main Interface -->
    <div id="pma-main" style="display:none;">
      <div class="pma-container">
        <div class="pma-header">
          <h1>
            <span class="icon icon-lg icon-primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <line x1="3" y1="9" x2="21" y2="9"/>
                <line x1="3" y1="15" x2="21" y2="15"/>
                <line x1="9" y1="21" x2="9" y2="9"/>
              </svg>
            </span>
            Database Manager
          </h1>
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
            <div class="pma-status">
              <span class="dot online" id="db-status-dot"></span>
              <span id="db-status-text">MySQL</span>
            </div>
            <button class="pma-refresh" id="pma-refresh">
              <span class="icon icon-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></span>
              Refresh
            </button>
            <button class="pma-logout" id="pma-logout">
              <span class="icon icon-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span>
              Logout
            </button>
          </div>
        </div>

        <div id="pma-error-container"></div>

        <div class="pma-tabs" id="pma-tabs">
          <button class="pma-tab active" data-table="users">Users <span class="badge" id="users-count">0</span></button>
          <button class="pma-tab" data-table="licenses">Licenses <span class="badge" id="licenses-count">0</span></button>
          <button class="pma-tab" data-table="sessions">Sessions <span class="badge" id="sessions-count">0</span></button>
          <button class="pma-tab" data-table="activities">Activities <span class="badge" id="activities-count">0</span></button>
          <button class="pma-tab" data-table="decorations">Decorations <span class="badge" id="decorations-count">0</span></button>
        </div>

        <div id="pma-content">
          <div class="pma-loading">
            <div class="spinner"></div>
            <div>Loading data...</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentTable = 'users';

    function showLogin() {
      document.getElementById('pma-login').style.display = 'block';
      document.getElementById('pma-main').style.display = 'none';
    }

    function showMain() {
      document.getElementById('pma-login').style.display = 'none';
      document.getElementById('pma-main').style.display = 'block';
    }

    async function checkAuth() {
      try {
        const res = await fetch('/api/pma/check');
        const data = await res.json();
        if (data.authenticated) {
          showMain();
          loadTable('users');
          return true;
        }
        showLogin();
        return false;
      } catch (err) {
        console.error('Auth check error:', err);
        showLogin();
        return false;
      }
    }

    // Login form
    document.getElementById('login-form-pma')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const user = document.getElementById('pma-user').value.trim();
      const pass = document.getElementById('pma-pass').value.trim();
      const error = document.getElementById('pma-error');
      const btn = document.querySelector('.btn-login');

      btn.disabled = true;
      btn.innerHTML = '<span class="icon icon-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span> Logging in...';
      error.style.display = 'none';

      try {
        const res = await fetch('/api/pma/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: user, password: pass })
        });

        const data = await res.json();

        if (data.success) {
          error.style.display = 'none';
          showMain();
          loadTable('users');
        } else {
          error.textContent = data.error || 'Invalid credentials';
          error.style.display = 'block';
          btn.disabled = false;
          btn.innerHTML = '<span class="icon icon-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg></span> Login';
        }
      } catch (err) {
        error.textContent = 'Network error: ' + err.message;
        error.style.display = 'block';
        btn.disabled = false;
        btn.innerHTML = '<span class="icon icon-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg></span> Login';
      }
    });

    // Logout
    document.getElementById('pma-logout')?.addEventListener('click', async () => {
      try {
        await fetch('/api/pma/logout', { method: 'POST' });
        showLogin();
      } catch (err) {
        console.error('Logout error:', err);
        showLogin();
      }
    });

    // Tabs
    document.querySelectorAll('.pma-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.pma-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        currentTable = this.dataset.table;
        loadTable(currentTable);
      });
    });

    // Refresh
    document.getElementById('pma-refresh')?.addEventListener('click', () => {
      loadTable(currentTable);
    });

    async function loadTable(table) {
      const content = document.getElementById('pma-content');
      const errorContainer = document.getElementById('pma-error-container');
      errorContainer.innerHTML = '';
      content.innerHTML = '<div class="pma-loading"><div class="spinner"></div><div>Loading...</div></div>';

      try {
        const res = await fetch(`/api/pma/${table}`);
        const data = await res.json();

        if (!res.ok) {
          if (res.status === 401) {
            errorContainer.innerHTML = '<div class="pma-error-box">Session expired. Please login again.</div>';
            showLogin();
            return;
          }
          errorContainer.innerHTML = `<div class="pma-error-box">Error: ${data.error || 'Failed to load'}</div>`;
          content.innerHTML = '';
          return;
        }

        if (!data.success) {
          errorContainer.innerHTML = `<div class="pma-error-box">Error: ${data.error || 'Failed to load'}</div>`;
          content.innerHTML = '';
          return;
        }

        // Update badges
        const badge = document.getElementById(`${table}-count`);
        if (badge) badge.textContent = data.count || 0;

        renderTable(content, table, data.rows);
      } catch (err) {
        errorContainer.innerHTML = `<div class="pma-error-box">Network error: ${err.message}</div>`;
        content.innerHTML = '';
      }
    }

    function renderTable(container, table, rows) {
      if (!rows || rows.length === 0) {
        container.innerHTML = `
          <div class="pma-table-wrap">
            <div class="table-header">
              <h3>${table.charAt(0).toUpperCase() + table.slice(1)}</h3>
              <span class="count">0 rows</span>
            </div>
            <div class="empty-state">
              <span class="icon" style="font-size:32px;display:block;margin-bottom:12px;">📭</span>
              No records found in ${table}
            </div>
          </div>
        `;
        return;
      }

      const columns = Object.keys(rows[0]);

      let html = `<div class="pma-table-wrap">
        <div class="table-header">
          <h3>${table.charAt(0).toUpperCase() + table.slice(1)}</h3>
          <span class="count">${rows.length} rows</span>
        </div>
        <div style="overflow-x:auto;">
        <table class="pma-table">
          <thead>
            <tr>`;

      columns.forEach(col => {
        html += `<th>${col.replace(/_/g, ' ')}</th>`;
      });
      html += `<th style="width:80px;">Actions</th></tr></thead><tbody>`;

      rows.forEach(row => {
        html += '<tr>';
        columns.forEach(col => {
          let val = row[col];
          if (val === null || val === undefined) {
            val = '<span class="null">NULL</span>';
          } else if (typeof val === 'object') {
            val = JSON.stringify(val).substring(0, 40);
          } else if (col === 'is_active') {
            val = val ? '<span class="active-yes">Yes</span>' : '<span class="active-no">No</span>';
          } else if (typeof val === 'string' && val.length > 60) {
            val = val.substring(0, 60) + '...';
          }
          html += `<td>${val}</td>`;
        });
        html += `<td>
          <div class="pma-actions">
            <button class="edit" onclick="editRow('${table}', '${row.id || row.user_id || ''}')">Edit</button>
            <button class="delete" onclick="deleteRow('${table}', '${row.id || row.user_id || ''}')">Delete</button>
          </div>
        </td></tr>`;
      });

      html += '</tbody></table></div></div>';
      container.innerHTML = html;
    }

    function editRow(table, id) {
      alert(`Edit ${table} row: ${id} (coming soon)`);
    }

    function deleteRow(table, id) {
      if (!confirm(`Delete ${table} row: ${id}? This cannot be undone!`)) return;
      alert(`Delete ${table} row: ${id} (coming soon)`);
    }

    // Check auth on load
    checkAuth();

    // Auto-refresh every 30s
    setInterval(() => {
      if (document.getElementById('pma-main').style.display !== 'none') {
        loadTable(currentTable);
      }
    }, 30000);
  </script>
</body>
</html>
