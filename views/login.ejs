<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .login-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 20px;
      height: 20px;
      vertical-align: middle;
    }
    .login-icon svg {
      width: 100%;
      height: 100%;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .login-icon-lg { width: 48px; height: 48px; }

    .login-container {
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }
    .login-box {
      max-width: 400px;
      width: 100%;
      background: #1a1a1a;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 40px 32px;
    }
    .login-box .logo {
      text-align: center;
      margin-bottom: 28px;
    }
    .login-box .logo .icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      height: 64px;
      background: rgba(74,158,255,0.1);
      border-radius: 16px;
      margin-bottom: 12px;
      color: #4a9eff;
    }
    .login-box .logo .icon svg {
      width: 32px;
      height: 32px;
      stroke-width: 1.8;
    }
    .login-box .logo h1 {
      font-size: 28px;
      font-weight: 700;
      color: #ffffff;
      margin: 0;
    }
    .login-box .logo h1 span {
      color: #4a9eff;
    }
    .login-box .logo p {
      font-size: 14px;
      color: #666666;
      margin: 4px 0 0;
    }
    .login-box .form-group {
      margin-bottom: 16px;
    }
    .login-box .form-group label {
      display: block;
      font-size: 13px;
      color: #888888;
      margin-bottom: 4px;
    }
    .login-box .form-group .input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }
    .login-box .form-group .input-wrapper .icon {
      position: absolute;
      left: 12px;
      color: #666666;
      width: 18px;
      height: 18px;
    }
    .login-box .form-group .input-wrapper input {
      width: 100%;
      padding: 10px 14px 10px 40px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 6px;
      color: #ffffff;
      font-size: 14px;
      outline: none;
      transition: border-color 0.3s ease;
      font-family: 'SF Mono', 'Menlo', 'Monaco', monospace;
    }
    .login-box .form-group .input-wrapper input:focus {
      border-color: #4a9eff;
    }
    .login-box .form-group .input-wrapper input::placeholder {
      color: #444444;
    }
    .login-box .error {
      background: rgba(255,50,50,0.1);
      border: 1px solid rgba(255,50,50,0.2);
      border-radius: 6px;
      padding: 10px 14px;
      color: #ff6b6b;
      font-size: 13px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .login-box .error .icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }
    .login-box .btn {
      width: 100%;
      padding: 12px;
      background: #4a9eff;
      border: none;
      border-radius: 6px;
      color: #ffffff;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .login-box .btn:hover {
      background: #3a7acc;
      transform: translateY(-1px);
    }
    .login-box .btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }
    .login-box .btn .icon {
      width: 18px;
      height: 18px;
    }
    .login-box .btn .spinner {
      display: none;
      width: 18px;
      height: 18px;
      animation: spin 0.8s linear infinite;
    }
    .login-box .btn.loading .spinner {
      display: block;
    }
    .login-box .btn.loading .btn-text {
      opacity: 0.7;
    }
    .login-box .footer {
      text-align: center;
      margin-top: 20px;
      font-size: 12px;
      color: #444444;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .login-box .footer .icon {
      width: 14px;
      height: 14px;
      color: #333333;
    }
    .login-box .help-text {
      text-align: center;
      font-size: 12px;
      color: #555555;
      margin-top: 12px;
      padding: 8px;
      background: rgba(255,255,255,0.02);
      border-radius: 4px;
      border: 1px solid rgba(255,255,255,0.03);
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="login-container">
      <div class="login-box">
        <div class="logo">
          <div class="icon">
            <svg viewBox="0 0 128 128">
              <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
              <rect x="4" y="4" width="120" height="120" rx="24" stroke="#4a9eff" stroke-width="2.5"/>
              <text x="64" y="82" font-size="52" font-weight="700" fill="#4a9eff" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif">RI</text>
            </svg>
          </div>
          <h1>Ro<span>Iron</span></h1>
          <p>Sign in with your secret key</p>
        </div>
        
        <% if (error) { %>
          <div class="error">
            <span class="icon">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </span>
            <%= error %>
          </div>
        <% } %>
        
        <form method="POST" action="/api/auth/login" id="login-form">
          <div class="form-group">
            <label for="secretKey">Secret Key</label>
            <div class="input-wrapper">
              <span class="icon">
                <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" id="secretKey" name="secretKey" placeholder="Enter your secret key" required autofocus />
            </div>
          </div>
          <button type="submit" class="btn" id="login-btn">
            <span class="spinner">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none"/><path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="2" fill="none"/></svg>
            </span>
            <span class="btn-text">Sign In</span>
            <span class="icon">
              <svg viewBox="0 0 24 24"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
            </span>
          </button>
        </form>
        
        <div class="help-text">
          <span class="login-icon login-icon-sm">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          Need a secret key? Contact support
        </div>
        
        <div class="footer">
          <span class="icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <span>RoIron</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('login-form');
      const btn = document.getElementById('login-btn');
      const secretKeyInput = document.getElementById('secretKey');

      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const secretKey = secretKeyInput.value.trim();
        if (!secretKey) {
          showError('Please enter your secret key');
          return;
        }

        btn.classList.add('loading');
        btn.disabled = true;
        btn.querySelector('.btn-text').textContent = 'Signing in...';

        try {
          const response = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ secretKey })
          });

          const data = await response.json();

          if (data.success) {
            window.location.href = '/dashboard';
          } else {
            showError(data.error || 'Invalid secret key');
            btn.classList.remove('loading');
            btn.disabled = false;
            btn.querySelector('.btn-text').textContent = 'Sign In';
          }
        } catch (error) {
          showError('Network error. Please try again.');
          btn.classList.remove('loading');
          btn.disabled = false;
          btn.querySelector('.btn-text').textContent = 'Sign In';
        }
      });

      function showError(message) {
        const existing = document.querySelector('.error');
        if (existing) existing.remove();

        const errorDiv = document.createElement('div');
        errorDiv.className = 'error';
        errorDiv.innerHTML = `
          <span class="icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </span>
          ${message}
        `;

        const logo = document.querySelector('.logo');
        logo.after(errorDiv);
      }

      secretKeyInput.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
          form.dispatchEvent(new Event('submit'));
        }
      });
    });
  </script>
</body>
</html>
