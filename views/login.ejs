<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="container" style="max-width:500px;">
      <div class="section-header">
        <h2>Login</h2>
        <p>Enter your secret key to access your dashboard</p>
      </div>
      <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:30px;">
        <form id="login-form">
          <label style="display:block;font-size:13px;color:#888888;margin-bottom:6px;">Secret Key</label>
          <input type="password" id="secret-key" placeholder="ROIRON-SECRET-XXXX-XXXX-XXXX-XXXX" style="width:100%;padding:12px 16px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:8px;color:#ffffff;font-size:14px;font-family:monospace;outline:none;" />
          <button type="submit" class="btn btn-primary" style="width:100%;margin-top:16px;justify-content:center;">Login</button>
        </form>
        <div id="login-error" style="margin-top:12px;font-size:13px;color:#ff6b6b;display:none;"></div>
        <div style="margin-top:16px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.06);font-size:13px;color:#666666;text-align:center;">
          Don't have a key? <a href="/license" style="color:#4a9eff;">Get license</a>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const key = document.getElementById('secret-key').value.trim();
      const errorEl = document.getElementById('login-error');
      if (!key) {
        errorEl.textContent = 'Please enter your secret key';
        errorEl.style.display = 'block';
        return;
      }
      errorEl.style.display = 'none';
      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ secretKey: key })
        });
        const data = await res.json();
        if (data.success) {
          localStorage.setItem('roiron_user_id', data.userId);
          localStorage.setItem('roiron_username', data.username);
          localStorage.setItem('roiron_xp', data.xp);
          localStorage.setItem('roiron_level', data.level);
          window.location.href = '/dashboard';
        } else {
          errorEl.textContent = data.error || 'Invalid secret key';
          errorEl.style.display = 'block';
        }
      } catch (err) {
        errorEl.textContent = 'Network error. Please try again.';
        errorEl.style.display = 'block';
      }
    });
  </script>
</body>
</html>
