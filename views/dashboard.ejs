<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128'%3E%3Crect width='128' height='128' rx='28' fill='%230a0a0a'/%3E%3Crect x='4' y='4' width='120' height='120' rx='24' stroke='%234a9eff' stroke-width='2.5'/%3E%3Ctext x='64' y='82' font-size='52' font-weight='700' fill='%234a9eff' text-anchor='middle' font-family='Helvetica Neue, sans-serif'%3ERI%3C/text%3E%3C/svg%3E" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="container" style="max-width:700px;">
      <div style="display:flex;align-items:center;justify-content:space-between;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,0.06);margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <h2 style="font-size:28px;font-weight:700;color:#ffffff;margin:0;">Dashboard</h2>
          <p style="font-size:14px;color:#888888;margin-top:4px;">
            Welcome back, <span style="color:#4a9eff;font-weight:600;"><%= user.username %></span>
          </p>
        </div>
        <a href="/logout" style="padding:8px 18px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.06);border-radius:6px;color:#888888;text-decoration:none;font-size:13px;font-weight:500;transition:all 0.3s ease;display:flex;align-items:center;gap:6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Sign Out
        </a>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));gap:16px;margin-bottom:24px;">
        <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:20px;text-align:center;">
          <div style="font-size:32px;font-weight:700;color:#4a9eff;"><%= user.level || 1 %></div>
          <div style="font-size:12px;color:#888888;margin-top:4px;">Level</div>
        </div>
        <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:20px;text-align:center;">
          <div style="font-size:32px;font-weight:700;color:#ffd700;"><%= user.xp || 0 %></div>
          <div style="font-size:12px;color:#888888;margin-top:4px;">Total XP</div>
        </div>
        <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:20px;text-align:center;">
          <div style="font-size:32px;font-weight:700;color:#4CAF50;">
            <% const hours = Math.floor((user.playtime || 0) / 60); const mins = (user.playtime || 0) % 60; %>
            <%= hours %>h <%= mins %>m
          </div>
          <div style="font-size:12px;color:#888888;margin-top:4px;">Playtime</div>
        </div>
      </div>

      <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:20px;">
        <div style="display:flex;flex-direction:column;gap:12px;">
          <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.04);font-size:14px;">
            <span style="color:#888888;">User ID</span>
            <code style="color:#4a9eff;font-size:13px;font-family:monospace;"><%= user.userId %></code>
          </div>
          <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.04);font-size:14px;">
            <span style="color:#888888;">Roblox ID</span>
            <code style="color:#4a9eff;font-size:13px;font-family:monospace;"><%= user.robloxId || '—' %></code>
          </div>
          <div style="display:flex;justify-content:space-between;padding:8px 0;font-size:14px;">
            <span style="color:#888888;">Decoration</span>
            <span style="color:#cccccc;text-transform:capitalize;"><%= user.decoration || 'none' %></span>
          </div>
        </div>
      </div>

      <div style="margin-top:20px;padding:14px 18px;background:rgba(74,158,255,0.04);border:1px solid rgba(74,158,255,0.08);border-radius:6px;display:flex;align-items:center;gap:10px;font-size:13px;color:#666666;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4a9eff" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
        <span>Your session is active and will be remembered for 30 days.</span>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    // Verify session on load
    fetch('/api/auth/session')
      .then(res => res.json())
      .then(data => {
        if (!data.authenticated) {
          window.location.href = '/login';
        }
      })
      .catch(() => {
        window.location.href = '/login';
      });
  </script>
</body>
</html>
