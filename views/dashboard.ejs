<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/icons.css" />
  <style>
    .dashboard-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin-bottom: 24px;
    }
    .stat-card {
      background: #141414;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 10px;
      padding: 16px 20px;
      text-align: center;
    }
    .stat-card .value {
      font-size: 28px;
      font-weight: 700;
      color: #4a9eff;
    }
    .stat-card .label {
      font-size: 12px;
      color: #888888;
      margin-top: 4px;
    }
    .btn-logout {
      padding: 8px 20px;
      background: rgba(255,50,50,0.1);
      border: 1px solid rgba(255,50,50,0.2);
      border-radius: 6px;
      color: #ff6b6b;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.3s ease;
      text-decoration: none;
    }
    .btn-logout:hover {
      background: rgba(255,50,50,0.2);
    }
    .refresh-btn {
      padding: 6px 16px;
      background: rgba(74,158,255,0.1);
      border: 1px solid rgba(74,158,255,0.2);
      border-radius: 6px;
      color: #4a9eff;
      cursor: pointer;
      font-size: 12px;
      font-weight: 500;
      transition: all 0.3s ease;
    }
    .refresh-btn:hover {
      background: rgba(74,158,255,0.2);
    }
    .last-updated {
      font-size: 11px;
      color: #444444;
      text-align: center;
      margin-top: 8px;
    }
  </style>
</head>
<body>
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <span class="icon icon-lg icon-white">
          <svg viewBox="0 0 128 128" fill="none">
            <rect width="128" height="128" rx="28" fill="#0a0a0a"/>
            <rect x="4" y="4" width="120" height="120" rx="24" stroke="currentColor" stroke-width="2.5"/>
            <text x="64" y="82" font-size="52" font-weight="700" fill="currentColor" text-anchor="middle" font-family="Helvetica Neue, Helvetica, Arial, sans-serif">RI</text>
          </svg>
        </span>
        RoIron
      </a>
      <nav class="nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/stats" class="nav-link">Stats</a>
        <button class="refresh-btn" id="refresh-stats">Refresh</button>
        <a href="/logout" class="btn-logout">Logout</a>
      </nav>
    </div>
  </header>

  <main style="padding:40px 20px;">
    <div class="container">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <h1 style="font-size:28px;font-weight:700;color:#ffffff;margin:0;">Dashboard</h1>
          <p style="color:#888888;font-size:14px;margin:4px 0 0;">Welcome, <strong style="color:#ffffff;" id="username-display"><%= user.username || 'User' %></strong></p>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
          <span style="padding:4px 14px;background:rgba(76,175,80,0.15);border:1px solid rgba(76,175,80,0.2);border-radius:20px;font-size:12px;color:#4CAF50;">Active</span>
        </div>
      </div>

      <div class="dashboard-stats" id="stats-grid">
        <div class="stat-card">
          <div class="value" id="xp-display"><%= user.xp || 0 %></div>
          <div class="label">Total XP</div>
        </div>
        <div class="stat-card">
          <div class="value" id="level-display"><%= user.level || 1 %></div>
          <div class="label">Level</div>
        </div>
        <div class="stat-card">
          <div class="value" id="playtime-display"><%= Math.floor((user.playtime || 0) / 60) %>h <%= (user.playtime || 0) % 60 %>m</div>
          <div class="label">Playtime</div>
        </div>
        <div class="stat-card">
          <div class="value" id="decoration-display"><%= user.decoration || 'none' %></div>
          <div class="label">Decoration</div>
        </div>
      </div>

      <div class="last-updated" id="last-updated">Loading...</div>

      <div style="background:#141414;border:1px solid rgba(255,255,255,0.06);border-radius:10px;padding:20px;margin-top:16px;">
        <h2 style="font-size:16px;font-weight:600;color:#ffffff;margin:0 0 12px;">Account Info</h2>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:13px;color:#888888;">
          <div><strong style="color:#cccccc;">User ID:</strong> <span id="user-id-display"><%= user.userId || 'N/A' %></span></div>
          <div><strong style="color:#cccccc;">Roblox ID:</strong> <span id="roblox-id-display"><%= user.robloxId || 'N/A' %></span></div>
          <div><strong style="color:#cccccc;">Secret Key:</strong> <code style="background:rgba(255,255,255,0.04);padding:2px 8px;border-radius:4px;color:#4a9eff;" id="secret-display"><%= user.secretKey ? user.secretKey.substring(0, 20) + '...' : 'N/A' %></code></div>
          <div><strong style="color:#cccccc;">Joined:</strong> <%= new Date().toLocaleDateString() %></div>
        </div>
      </div>

      <div style="margin-top:16px;padding:12px 16px;background:rgba(74,158,255,0.03);border:1px solid rgba(74,158,255,0.06);border-radius:8px;">
        <div style="display:flex;align-items:center;gap:8px;font-size:13px;color:#888888;">
          <span class="icon icon-sm icon-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </span>
          <span>Data is fetched directly from the RoIron API server</span>
        </div>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-bottom">
        &copy; <%= year %> RoIron. All rights reserved.
      </div>
    </div>
  </footer>

  <script>
    async function refreshStats() {
      try {
        document.getElementById('last-updated').textContent = 'Refreshing...';
        
        const res = await fetch('/api/auth/session');
        const data = await res.json();
        
        if (data.authenticated) {
          document.getElementById('xp-display').textContent = data.xp || 0;
          document.getElementById('level-display').textContent = data.level || 1;
          const playtime = data.playtime_minutes || 0;
          document.getElementById('playtime-display').textContent = Math.floor(playtime / 60) + 'h ' + (playtime % 60) + 'm';
          document.getElementById('username-display').textContent = data.username || 'User';
          document.getElementById('user-id-display').textContent = data.userId || 'N/A';
          
          document.getElementById('last-updated').textContent = 'Updated: ' + new Date().toLocaleString();
        } else {
          document.getElementById('last-updated').textContent = 'Session expired — please login again';
        }
      } catch (e) {
        document.getElementById('last-updated').textContent = 'Error refreshing data';
        console.error('[Dashboard] Refresh error:', e);
      }
    }

    document.getElementById('refresh-stats')?.addEventListener('click', refreshStats);
    
    // Initial load
    setTimeout(refreshStats, 500);
    
    // Auto-refresh every 30 seconds
    setInterval(refreshStats, 30000);
  </script>
</body>
</html>
