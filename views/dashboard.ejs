<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="container" style="max-width:700px;">
      <div class="section-header">
        <h2>Dashboard</h2>
        <p>Welcome back, <span id="username" style="color:#4a9eff;">User</span>!</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-bottom:24px;">
        <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:16px;text-align:center;">
          <div style="font-size:24px;font-weight:700;color:#4a9eff;" id="level">1</div>
          <div style="font-size:11px;color:#888888;">Level</div>
        </div>
        <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:16px;text-align:center;">
          <div style="font-size:24px;font-weight:700;color:#ffd700;" id="xp">0</div>
          <div style="font-size:11px;color:#888888;">XP</div>
        </div>
        <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:16px;text-align:center;">
          <div style="font-size:24px;font-weight:700;color:#4CAF50;" id="playtime">0h 0m</div>
          <div style="font-size:11px;color:#888888;">Playtime</div>
        </div>
      </div>
      <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.06);border-radius:8px;padding:16px;">
        <div style="font-size:13px;color:#888888;margin-bottom:4px;">User ID</div>
        <code style="color:#4a9eff;font-size:12px;" id="user-id">—</code>
        <div style="margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,0.04);font-size:12px;color:#444444;">
          This is your RoIron profile data. It's synced with the extension.
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    const userId = localStorage.getItem('roiron_user_id');
    const username = localStorage.getItem('roiron_username') || 'User';
    const xp = parseInt(localStorage.getItem('roiron_xp')) || 0;
    const level = parseInt(localStorage.getItem('roiron_level')) || 1;
    const playtime = parseInt(localStorage.getItem('roiron_playtime')) || 0;

    document.getElementById('username').textContent = username;
    document.getElementById('level').textContent = level;
    document.getElementById('xp').textContent = xp;
    document.getElementById('user-id').textContent = userId || '—';

    const hours = Math.floor(playtime / 60);
    const mins = playtime % 60;
    document.getElementById('playtime').textContent = hours + 'h ' + mins + 'm';

    if (!userId) {
      window.location.href = '/login';
    }
  </script>
</body>
</html>
